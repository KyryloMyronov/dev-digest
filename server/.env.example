# @devdigest/api environment
DATABASE_URL=postgres://devdigest:devdigest@localhost:5432/devdigest

# LLM providers (BYO key — entered via Settings UI in prod; env for local dev).
# Optional: the app boots with none. A key is only needed for the provider you
# actually run a review on (or embeddings, see EMBEDDINGS_ENABLED).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Completion cap (max_tokens) for LLM calls that don't set their own (default
# 8192). Always sent: without it OpenRouter reserves the model's FULL output
# window against your balance and 402s low-credit accounts pre-flight
# ("requires more credits, or fewer max_tokens"). Lower it if you still hit
# that error; raise it if reviews come back truncated.
LLM_MAX_OUTPUT_TOKENS=8192

# GitHub (REST via Octokit) — PAT with repo scope. Canonical name is
# GITHUB_TOKEN; GITHUB_PAT is still accepted as a fallback for back-compat.
GITHUB_TOKEN=

# Memory/RAG embeddings (OpenAI text-embedding-3-small). Default OFF → the app
# makes ZERO OpenAI requests. Set true to enable memory retrieval.
EMBEDDINGS_ENABLED=false

# repo-intel facade (Tier 1: repo skeleton + callers in the review prompt).
# Default ON; set false to degrade every consumer to ripgrep-only behavior.
REPO_INTEL_ENABLED=true

# Per-section prompt logging: section name, provenance, trusted/untrusted, size
# in chars (+ tokens), the model used and a correlation id. NEVER the content —
# no diff, no PR body, no spec text, no secrets (see platform/prompt-log.ts).
# A one-line summary is logged regardless; this adds the per-section breakdown.
# LOCAL ONLY: ignored under NODE_ENV=production (the server warns at boot if you
# set it there). The breakdown logs at DEBUG, so you also need LOG_LEVEL=debug.
PROMPT_LOG_VERBOSE=false

API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults: info, silent in test)
LOG_LEVEL=
DEVDIGEST_CLONE_DIR=./clones
